ADMIN_PLATFORM_SECRET_KEY=replace-with-a-random-local-value
ADMIN_PLATFORM_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_PLATFORM_CORS_ORIGINS=http://localhost:5173
